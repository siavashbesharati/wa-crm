{
  "manifest_version": 3,
  "name": "پاسخ خودکار چندکاناله",
  "description": "CRM و پاسخ خودکار واتساپ و دیوار. توسعه: iranexpedia.ir",
  "version": "7.5.2",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://divar.ir/*",
    "https://chat.divar.ir/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "پاسخ خودکار چندکاناله",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "options_page": "dashboard.html",
  "web_accessible_resources": [
    {
      "resources": [
        "crm-panel.css"
      ],
      "matches": [
        "https://web.whatsapp.com/*",
        "https://divar.ir/*",
        "https://chat.divar.ir/*"
      ]
    },
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://divar.ir/*",
        "https://*.divar.ir/*",
        "https://chat.divar.ir/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "reply-trace.js",
        "cloud-bridge.js",
        "auth-gate.js",
        "crm-store.js",
        "content.js",
        "crm-panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://divar.ir/chat",
        "https://divar.ir/chat/*",
        "https://chat.divar.ir/*",
        "https://chat.divar.ir/chat",
        "https://chat.divar.ir/chat/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://divar.ir/chat",
        "https://divar.ir/chat/*",
        "https://chat.divar.ir/*",
        "https://chat.divar.ir/chat",
        "https://chat.divar.ir/chat/*"
      ],
      "js": [
        "cloud-bridge.js",
        "auth-gate.js",
        "crm-store.js",
        "content-divar.js",
        "crm-panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
