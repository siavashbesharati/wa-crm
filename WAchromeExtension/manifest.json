{
  "manifest_version": 3,
  "name": "iranexpedia.ir — پاسخ خودکار واتساپ",
  "description": "پاسخ خودکار واتساپ وب با کلمه کلیدی | دانلود اعضای گروه | iranexpedia.ir",
  "version": "5.2.1",
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "iranexpedia.ir v5.2.1",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
