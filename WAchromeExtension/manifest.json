{
  "manifest_version": 3,
  "name": "پاسخ خودکار واتساپ",
  "description": "پاسخ خودکار پیام‌های واتساپ وب با کلمه کلیدی. توسعه: iranexpedia.ir",
  "version": "5.3.1",
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://worldtimeapi.org/*",
    "https://timeapi.io/*",
    "https://www.cloudflare.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "پاسخ خودکار واتساپ",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["license-config.js", "license-lib.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
