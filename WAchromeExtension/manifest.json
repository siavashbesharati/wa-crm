{
  "manifest_version": 3,
  "name": "پاسخ خودکار واتساپ",
  "description": "CRM و پاسخ خودکار واتساپ وب با زمان‌بندی. توسعه: iranexpedia.ir",
  "version": "7.1.2",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "پاسخ خودکار واتساپ",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "options_page": "dashboard.html",
  "web_accessible_resources": [
    {
      "resources": ["crm-panel.css"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "cloud-bridge.js",
        "auth-gate.js",
        "crm-store.js",
        "content.js",
        "crm-panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
