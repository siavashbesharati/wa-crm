# ============================================================================
# Iranexpedia platform — root .env example
# Copy to .env and edit. docker compose reads this file automatically.
# ============================================================================

# --- Postgres (used by the API and worker) -------------------------------
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# --- API (FastAPI) --------------------------------------------------------
APP_ENV=production
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
SUPER_ADMIN_PHONE=09120674032
SMS_IR_DEV_FALLBACK=true
TZ=Asia/Tehran

# --- Next.js (build-time) -------------------------------------------------
# This URL is baked into the JS bundle at build time, so changing it
# requires `docker compose build web` (or restart the dev container).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- External API keys (real values for production) ----------------------
# Rotate the SMS provider key before going live (the one committed to
# source is a public test key).
SMS_IR_API_KEY=your_sms_ir_key_here
SMS_IR_TEMPLATE_ID=846743
SMS_IR_OTP_PARAM=OTP

# Optional: HTTPS proxy for sms.ir if your VPS blocks Iranian APIs
# SMS_IR_HTTPS_PROXY=http://127.0.0.1:10809

# --- AI providers (any one is sufficient; OpenAI is preferred) -----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- RAG knowledge base (Pinecone serverless) -----------------------------
PINECONE_API_KEY=
PINECONE_INDEX=iranexpedia-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Payment provider ----------------------------------------------------
PAYMENT_PROVIDER=zibal        # zibal | mock
ZIBAL_MERCHANT_ID=zibal

# --- Per-connector tunables (rarely needed) -------------------------------
# WA_POLL_MS=2000
# WA_SESSION_REFRESH_MS=15000
# DIVAR_POLL_INBOUND=6
# BALE_POLL_SESSIONS=8
