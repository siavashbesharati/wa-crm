# ============================================================================
# Miogen / Iranexpedia — copy to .env and edit before `docker compose up`
# ============================================================================

# --- Host binding (production VPS: leave default 127.0.0.1) ---------------
# Nginx on the same machine proxies to these ports. Do NOT use 0.0.0.0 on a
# public VPS unless you intend to bypass Cloudflare on ports 3000/8000.
HOST_BIND=127.0.0.1

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=crm

# --- API (FastAPI) --------------------------------------------------------
APP_ENV=production
CORS_ORIGINS=https://miogen.iranexpedia.ir
PUBLIC_BASE_URL=https://miogen.iranexpedia.ir
WEB_BASE_URL=https://miogen.iranexpedia.ir
SUPER_ADMIN_PHONE=09120674032
SMS_IR_DEV_FALLBACK=false
TZ=Asia/Tehran

# --- Next.js (build-time — rebuild web after changing) --------------------
NEXT_PUBLIC_API_URL=https://miogen.iranexpedia.ir/api

# --- External API keys ----------------------------------------------------
SMS_IR_API_KEY=your_sms_ir_key_here
SMS_IR_TEMPLATE_ID=846743
SMS_IR_OTP_PARAM=OTP
# SMS_IR_HTTPS_PROXY=http://127.0.0.1:10809

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

PINECONE_API_KEY=
PINECONE_INDEX=iranexpedia-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

PAYMENT_PROVIDER=zibal
ZIBAL_MERCHANT_ID=zibal
