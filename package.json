{
  "name": "iranexpedia-platform",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:all": "node scripts/start-all.mjs",
    "stop:all": "node scripts/stop-all.mjs",
    "api:dev": "cd platform/api && python -m uvicorn app.main:app --reload --port 8000",
    "web:dev": "cd platform/web && npm run dev",
    "workers:dev": "cd platform/api && python -m app.workers.runner",
    "wa:dev": "cd platform/wa-connector && npm run dev",
    "divar:dev": "cd platform/divar-connector && python main.py",
    "bale:dev": "cd platform/bale-connector && python main.py",
    "instagram:dev": "cd platform/instagram-connector && python main.py",
    "api:seed": "cd platform/api && python scripts/seed_demo.py"
  }
}
